    "database": {"env_prefix": "DB"},
    "storage": {"path_env": "INSTANCE_STORAGE_ROOT"},
    "rag": {"env_prefix": "QDRANT", "collection_prefix": "local__"},
    "session": {"namespace": "25bf8e1a2393"},
    "secrets": {"scope": "local"},
    "backups": {"scope": "local"}
