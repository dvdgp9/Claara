{
  "schema_version": 1,
  "id": "local",
  "slug": "local",
  "status": "active",
  "canonical_domain": "localhost",
  "domains": ["localhost", "127.0.0.1"],
  "branding": {
    "product_name": "Claara",
    "organization_name": "Local development",
    "logo_path": "/assets/images/logo.png",
